Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1
      Plane Cell Count: 24
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Odometry
      Topic:
        Value: /odom
        Depth: 5
      Keep: 50
      Shape:
        Value: Arrow
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: PlannedPath
      Topic:
        Value: /planned_path
        Depth: 5
      Color: 0; 200; 255
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Waypoints
      Topic:
        Value: /waypoint_markers
        Depth: 5
      Value: true
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: CurrentGoal
      Topic:
        Value: /current_goal
        Depth: 5
      Color: 255; 80; 0
      Shape: Axes
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: Scan
      Topic:
        Value: /scan
        Depth: 5
      Size (m): 0.08
      Color: 255; 255; 0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 28
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.85
      Yaw: 0.78
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
  X: 40
  Y: 40
